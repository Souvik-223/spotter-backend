# ==============================================================================
# .gitignore for Spotter Backend (Django + uv)
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments (uv / venv / pipenv / conda)
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
.env.*
!.env.example
*.local

# Django & Database
*.sqlite3
db.sqlite3
staticfiles/
media/

# Test, Lint, and Cache
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# IDE & Operating System
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# AI / Agent workspace metadata & internal dev logs
.agents/
.claude/
.codex/
/tasks/
tasks
